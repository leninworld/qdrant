+                VectorToStore::Decoded(VectorRef::MultiDense(TypedMultiDenseVectorRef::new(
+                    point, DIM,
+                )))
+            }),
+        )
+        .unwrap();
+    drop(writer);
+
+    let typed_rows: Vec<Vec<f16>> = points
+        .iter()
+        .flatten()
+        .map(|row| row.iter().map(|&value| f16::from_f32(value)).collect())
+        .collect();
