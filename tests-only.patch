+fn uint8_multivector_rows() -> Vec<Vec<Vec<f32>>> {
+    vec![
+        vec![
+            vec![0.0, 32.0, 64.0, 96.0, 128.0, 160.0, 224.0, 255.0],
+            vec![255.0, 128.0, 127.0, 1.0, 254.0, 126.0, 129.0, 0.0],
